# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored — never commit real secrets.

# --- Resend (reviews & reservation emails) ---
RESEND_API_KEY=

# --- Square (online checkout) ---
# 'sandbox' while testing, 'production' when you're ready to accept real cards
SQUARE_ENV=sandbox

# Server-side only (used by api/create-payment.js) — never exposed to the browser
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=

# Client-side (used by the Web Payments SDK in the browser) — must be prefixed
# with VITE_ so Vite exposes them to the frontend build. Not secret.
VITE_SQUARE_ENV=sandbox
VITE_SQUARE_APP_ID=
VITE_SQUARE_LOCATION_ID=

# --- Square webhooks (order status emails to the customer) ---
# From Developer Dashboard > your app > Webhooks: the "Signature Key" of the
# subscription, and the exact Notification URL you registered there (needed
# to verify the signature) — see README for setup steps.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=

# --- Admin panel (/admin) ---
# Password the owner uses to log in. Changing it logs everyone out.
ADMIN_PASSWORD=

# Upstash Redis (menu, options, hours). Created by Vercel when you connect
# Storage > Upstash for Redis to the project. Without it the site uses the
# default menu and the panel can't save.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob (uploaded product photos). Created when you connect a Blob store.
BLOB_READ_WRITE_TOKEN=
